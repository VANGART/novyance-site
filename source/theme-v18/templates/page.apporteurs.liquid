{% layout none %}
{%- comment -%}
  Programme apporteurs d'affaires (07/10/2026, offre « prospection à la commission » depuis le 14/10/2026). Deux usages :
  - sans code : le programme, et un formulaire pour devenir apporteur ;
  - avec ?a=CODE : l'espace de l'apporteur, avec son lien personnel et un message prêt à transférer.
  Les appels vont à la fonction publique Supabase « parrainage ».
{%- endcomment -%}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="only light">
<meta name="theme-color" content="#F3F6FA">
<title>Devenir apporteur d'affaires · 15 % de notre commission · Novyance</title>
<meta name="description" content="Vous connaissez des entreprises qui vendent aux pros et veulent plus de clients ? Présentez-les à Novyance : vous touchez 15 % de notre commission pendant un an.">
<meta name="robots" content="index, follow, max-image-preview:large">
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:title" content="Devenir apporteur d'affaires Novyance">
<meta property="og:description" content="Présentez à Novyance des entreprises qui veulent plus de clients : vous touchez 15 % de notre commission pendant un an.">
<meta property="og:image" content="{{ 'nv-og.png' | asset_url | prepend: 'https:' }}">
<link rel="icon" type="image/png" sizes="48x48" href="{{ 'nv-favicon-48.png' | asset_url }}">
<link rel="apple-touch-icon" href="{{ 'nv-apple-touch.png' | asset_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
{% render 'nv-parrainage-styles' %}
{{ content_for_header }}
</head>
<body>

<header>
  <div class="wrap">
    <a href="/" class="brand">novyance<span class="dot">.</span></a>
    <div class="rt">
      <a href="/">L'offre</a>
      <a href="#rejoindre" class="btn">Devenir apporteur</a>
      {% render 'nv-mnav' %}
    </div>
  </div>
</header>

<main>
  {%- comment -%} Espace de l'apporteur : rempli par le script quand le code est valide {%- endcomment -%}
  <section class="espace" id="espace" hidden>
    <div class="wrap">
      <h1 id="esp-titre">Votre lien personnel</h1>
      <p class="lead">Partagez ce lien avec les entreprises que vous voulez recommander. Quand elles nous laissent leurs coordonnées depuis cette page, on sait qu'elles viennent de vous, et votre commission est suivie automatiquement.</p>
      <div class="lien"><code id="esp-lien"></code><button class="btn" type="button" id="esp-copier">Copier le lien</button></div>
      <h2>Le message à transférer</h2>
      <p class="sub">Copiez-le tel quel ou adaptez-le, puis envoyez-le par mail, SMS ou WhatsApp.</p>
      <textarea id="esp-msg" rows="7" aria-label="Message à transférer"></textarea>
      <div class="actions"><button class="btn" type="button" id="esp-copier-msg">Copier le message</button><a class="btn ghost" id="esp-wa" href="#" target="_blank" rel="noopener">Ouvrir dans WhatsApp</a></div>
      <p class="sub">Vous pouvez aussi nous transmettre directement un contact : <b>07 86 52 36 81</b> ou <b>contact@novyance.fr</b>, en citant votre code <b id="esp-code"></b>.</p>
    </div>
  </section>

  <section class="hero">
    <div class="wrap">
      <h1>Vos clients veulent plus de clients. Présentez-les, vous touchez 15 % de notre commission<span class="dot">.</span></h1>
      <p class="lead">Comptables, conseils, imprimeurs, négoces, secrétariats, architectes : vous voyez passer des entreprises qui vendent aux pros et dont le carnet n'est jamais assez plein. Nous prospectons pour elles, payés uniquement sur les ventes qu'on leur apporte. Vous nous les présentez, et vous touchez <b>15 % de ce qu’on gagne avec elles pendant un an</b>.</p>
      <div class="actions"><a class="btn" href="#rejoindre">Devenir apporteur</a><a class="btn ghost" href="/">Ce qu'on propose à vos clients</a></div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>Comment ça marche</h2>
      <ol class="etapes">
        <li><b>Vous recevez votre lien personnel.</b><span>Une page à votre nom, qui explique à vos clients ce qu'on fait pour eux.</span></li>
        <li><b>Vous le transmettez.</b><span>Par mail, SMS, WhatsApp ou de vive voix. Un message tout prêt vous attend dans votre espace.</span></li>
        <li><b>On prépare un exemple pour votre client.</b><span>Sous 24 h, un vrai prospect choisi pour lui, le mail qu'on lui enverrait et l'échantillon. On vous tient au courant de chaque contact.</span></li>
        <li><b>Vous êtes payé dès que nous le sommes.</b><span>15 % de notre commission sur ce client pendant ses douze premiers mois, sur facture.</span></li>
      </ol>
    </div>
  </section>

  <section class="sec alt">
    <div class="wrap">
      <h2>Ce que ça représente</h2>
      <div class="cartes">
        <div><b>40 000 €</b><span>de ventes apportées à votre client sur l'année</span></div>
        <div><b>4 000 €</b><span>de commission Novyance, à 10 %</span></div>
        <div><b>600 €</b><span>pour vous, sans rien faire d'autre que la présentation</span></div>
      </div>
      <p class="sub">Exemple de calcul, chiffres indicatifs : le taux de commission se fixe avec chaque client selon ses marges. Plus on lui apporte de ventes, plus votre part monte.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>Ce qu'on propose à vos clients</h2>
      <ul class="briques">
        <li><b>La prospection à notre place</b> : on repère les entreprises qui ont une raison d'acheter maintenant et on leur écrit en leur nom, avec un échantillon de leur travail.</li>
        <li><b>Aucun risque</b> : 0 € de mise en place, pas d'abonnement, un pourcentage des ventes qu'on apporte. Un mois d'engagement, le temps de tout installer.</li>
        <li><b>L'exclusivité</b> : un seul client par métier et par zone.</li>
        <li><b>Un tableau de bord</b> où ils voient chaque entreprise contactée, chaque réponse, chaque vente.</li>
      </ul>
      <h2>Nos engagements envers vous</h2>
      <ul class="briques">
        <li>Aucune exclusivité, aucun objectif à tenir.</li>
        <li>On ne prend que les clients qu'on peut vraiment aider : c'est votre nom qui est en jeu.</li>
        <li>On vous informe de chaque contact transmis, et on paie vite.</li>
      </ul>
    </div>
  </section>

  <section class="sec alt" id="rejoindre">
    <div class="wrap">
      <h2>Devenir apporteur</h2>
      <p class="sub">Laissez vos coordonnées : on vous appelle pour faire connaissance, puis on vous envoie votre lien personnel et l'accord d'une page.</p>
      <form class="form" id="f-insc" novalidate>
        <div><label for="i-contact">Prénom et nom</label><input id="i-contact" autocomplete="name" required></div>
        <div><label for="i-soc">Entreprise</label><input id="i-soc" autocomplete="organization"></div>
        <div><label for="i-email">E-mail</label><input id="i-email" type="email" autocomplete="email"></div>
        <div><label for="i-tel">Téléphone</label><input id="i-tel" type="tel" autocomplete="tel"></div>
        <div class="full"><label for="i-metier">Votre activité, vos clients</label><input id="i-metier" placeholder="Ex. expert-comptable, surtout des ateliers et des PME qui vendent aux entreprises"></div>
        <input class="hp" id="i-hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="full"><button class="btn" type="submit">Je veux devenir apporteur</button><p class="msg" id="i-msg" role="status"></p></div>
      </form>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>Questions fréquentes</h2>
      <details><summary>Faut-il signer quelque chose ?</summary><p>Un accord d'une page : votre part, le moment du paiement, et rien d'autre. Pas d'exclusivité, pas de durée minimale.</p></details>
      <details><summary>Comment votre part est-elle calculée ?</summary><p>15 % de la commission que Novyance encaisse sur le client que vous avez présenté, pendant ses douze premiers mois. Elle vous est versée dès que nous avons été payés, sur facture.</p></details>
      <details><summary>Comment savez-vous que le client vient de moi ?</summary><p>Votre lien porte votre code. Quand le client laisse ses coordonnées depuis cette page, la recommandation vous est rattachée automatiquement. S'il nous appelle directement, il lui suffit de citer votre nom.</p></details>
      <details><summary>Et si le client ne démarre pas ?</summary><p>Rien ne vous est demandé. On vous dit simplement où en est le contact, pour que vous puissiez en parler avec lui.</p></details>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <span>Novyance · Aurélien Ruotte · Lyon · contact@novyance.fr · 07 86 52 36 81</span>
    <span class="lk"><a href="/">Accueil</a><a href="/#tarif">Tarif</a><a href="/blogs/blog">Blog</a><a href="/pages/cgv">CGV</a><a href="/pages/confidentialite">Confidentialité</a></span>
  </div>
</footer>

<script>
(function(){
  var API = "https://sqxlavinbiryvmblmtse.supabase.co/functions/v1/parrainage";
  function appel(corps){ return fetch(API, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(corps) }).then(function(r){ return r.json().then(function(j){ if (!r.ok) throw new Error(j.erreur || "erreur"); return j; }); }); }
  function copier(texte, bouton){
    var fini = function(){ var t = bouton.textContent; bouton.textContent = "Copié ✓"; setTimeout(function(){ bouton.textContent = t; }, 1600); };
    if (navigator.clipboard) navigator.clipboard.writeText(texte).then(fini, function(){ window.prompt("À copier :", texte); }); else window.prompt("À copier :", texte);
  }
  var code = (new URLSearchParams(location.search).get("a") || "").toUpperCase().replace(/[^A-Z0-9]/g, "");
  if (code) {
    appel({ action: "info", code: code }).then(function(a){
      var lien = "https://novyance.fr/pages/recommande?r=" + code;
      var qui = a.prenom || a.societe;
      document.getElementById("espace").hidden = false;
      document.getElementById("esp-titre").textContent = "Bonjour " + qui + ", voici votre lien personnel";
      document.getElementById("esp-lien").textContent = lien;
      document.getElementById("esp-code").textContent = code;
      var msg = "Bonjour,\n\nJe vous mets en relation avec Aurélien Ruotte (Novyance, Lyon). Il prospecte pour les entreprises qui vendent aux pros, et il n'est payé que sur les ventes qu'il apporte. Il peut vous préparer gratuitement un exemple sur un vrai prospect.\n\nTout est expliqué ici : " + lien + "\n\nBonne journée,";
      document.getElementById("esp-msg").value = msg;
      document.getElementById("esp-wa").href = "https://wa.me/?text=" + encodeURIComponent(msg);
      document.getElementById("esp-copier").addEventListener("click", function(){ copier(lien, this); });
      document.getElementById("esp-copier-msg").addEventListener("click", function(){ copier(document.getElementById("esp-msg").value, this); });
      document.querySelector(".hero").hidden = true;
      document.getElementById("rejoindre").hidden = true;
      appel({ action: "vue", code: code, page: "apporteur" }).catch(function(){});
    }).catch(function(){});
  }
  var f = document.getElementById("f-insc"), m = document.getElementById("i-msg");
  f.addEventListener("submit", function(e){
    e.preventDefault();
    var v = function(id){ return document.getElementById(id).value.trim(); };
    if (!v("i-contact")) { m.textContent = "Indiquez votre nom."; return; }
    if (!v("i-email") && !v("i-tel")) { m.textContent = "Indiquez un e-mail ou un téléphone."; return; }
    var b = f.querySelector("button"); b.disabled = true; m.textContent = "Envoi…";
    appel({ action: "inscription", contact: v("i-contact"), societe: v("i-soc"), email: v("i-email"), telephone: v("i-tel"), metier: v("i-metier"), hp: v("i-hp") })
      .then(function(){ f.innerHTML = '<p class="ok"><b>Merci, c\'est noté.</b> On vous appelle dans les 24 heures pour faire connaissance, puis on vous envoie votre lien personnel.</p>'; })
      .catch(function(err){ m.textContent = err.message; b.disabled = false; });
  });
})();
</script>
</body>
</html>
