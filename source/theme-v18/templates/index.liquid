<script>
(function(){
  var $ = function(s){ return document.querySelector(s); };
  /* quel formulaire a été envoyé : Shopify recharge la page avec ?contact_posted=true */
  ['f-demo','f-demo2','f-call'].forEach(function(id){
    var f = document.getElementById(id); if(!f) return;
    f.addEventListener('submit', function(e){
      var hp = document.getElementById(id + '-hp'); if(hp && hp.value){ e.preventDefault(); return; }
      try{ sessionStorage.setItem('nv-form', id); }catch(err){}
      if(id === 'f-call' || f.dataset.envoye) return;
      /* demande d'exemple : enregistrée dans le Pilotage (fonction exemple) ; le formulaire Shopify reste le secours */
      e.preventDefault();
      var site = f.querySelector('[name="contact[Site]"]').value, mail = f.querySelector('[name="contact[email]"]').value;
      var ok = document.getElementById(id === 'f-demo' ? 'ok1' : 'ok2'), btn = f.querySelector('button');
      btn.disabled = true;
      fetch('https://sqxlavinbiryvmblmtse.supabase.co/functions/v1/exemple', { method:'POST', headers:{'content-type':'application/json'},
        body: JSON.stringify({ action:'demande', site:site, email:mail, source: id === 'f-demo' ? 'accueil-haut' : 'accueil-bas', hp: hp ? hp.value : '' }) })
        .then(function(r){ return r.json().then(function(d){ return { ok:r.ok, d:d }; }); })
        .then(function(r){
          btn.disabled = false; ok.hidden = false;
          if(r.ok){ ok.innerHTML = '<p><b>C'est noté pour ' + site.replace(/[<>&"]/g,'') + '.</b> Votre exemple arrive par mail sous 24 h : un vrai prospect, le mail qu'il recevrait, son échantillon et vos premières cibles.</p>'; f.reset(); }
          else { ok.textContent = r.d.erreur || 'Une erreur s'est produite.'; }
        })
        .catch(function(){ f.dataset.envoye = '1'; f.submit(); });
    });
  });
  if(/contact_posted=true/.test(location.search)){
    var id = 'f-demo'; try{ id = sessionStorage.getItem('nv-form') || 'f-demo'; sessionStorage.removeItem('nv-form'); }catch(err){}
    var ok = { 'f-demo':'ok1', 'f-demo2':'ok2', 'f-call':'ok3' }[id], el = document.getElementById(ok);
    if(el){ el.hidden = false; addEventListener('DOMContentLoaded', function(){ el.scrollIntoView({block:'center'}); }); }
  }
  /* mentions et confidentialité */
  [].forEach.call(document.querySelectorAll('[data-dlg]'), function(b){ b.addEventListener('click', function(){ var d = document.getElementById(b.dataset.dlg); if(d && d.showModal) d.showModal(); }); });
  [].forEach.call(document.querySelectorAll('dialog [data-close]'), function(b){ b.addEventListener('click', function(){ b.closest('dialog').close(); }); });
  [].forEach.call(document.querySelectorAll('dialog'), function(d){ d.addEventListener('click', function(e){ if(e.target === d) d.close(); }); });
  /* barre d'action sur téléphone : visible après le haut de page, cachée en bas sur les formulaires */
  var b = $('#mbar'), hero = $('.hero'), end = $('#appel');
  if(b && hero && 'IntersectionObserver' in window){
    var apres = false, fin = false;
    var maj = function(){ var on = apres && !fin; b.classList.toggle('on', on); b.setAttribute('aria-hidden', on ? 'false' : 'true'); b.inert = !on; };
    new IntersectionObserver(function(e){ apres = !e[0].isIntersecting; maj(); }).observe(hero);
    if(end) new IntersectionObserver(function(e){ fin = e[0].isIntersecting; maj(); }, {threshold:.1}).observe(end);
  }
})();
</script>
</body>
</html>
