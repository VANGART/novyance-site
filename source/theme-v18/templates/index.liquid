<script id="nv-scenes">
(function(){
  var reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var $ = function(id){ return document.getElementById(id); };

  /* film : version verticale sur téléphone, bouton son */
  var v = $('film');
  if(v){
    /* vertical sur écran en portrait, horizontal sinon ; suit la rotation et le redimensionnement */
    var portrait = matchMedia('(max-aspect-ratio: 4/5)'), affiche = v.poster;
    function choisir(){
      var vertical = portrait.matches, src = vertical ? v.dataset.v : v.dataset.h;
      if(!src || v.currentSrc.indexOf(src.split('?')[0].split('/').pop()) > -1) return;
      v.poster = vertical ? v.dataset.vp : affiche; v.src = src; v.load();
      var q = v.play && v.play(); if(q && q.catch) q.catch(function(){});
    }
    choisir();
    if(portrait.addEventListener) portrait.addEventListener('change', choisir); else if(portrait.addListener) portrait.addListener(choisir);
    var p = v.play && v.play(); if(p && p.catch) p.catch(function(){});
    $('son').addEventListener('click', function(){
      v.muted = !v.muted; if(!v.muted){ v.currentTime = 0; v.play(); }
      this.setAttribute('aria-pressed', String(!v.muted));
      $('son-t').textContent = v.muted ? 'Activer le son' : 'Couper le son';
      $('son-onde').setAttribute('d', v.muted ? 'm16 9 5 6m0-6-5 6' : 'M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13');
    });
  }

  /* l'heure limite de l'exemple : maintenant + 24 h, recalculée chaque minute.
     Si elle tombe entre 21 h et 6 h, on annonce 9 h le matin (même règle côté serveur). */
  var JOURS = ['dimanche','lundi','mardi','mercredi','jeudi','vendredi','samedi'];
  function majLimite(){
    var d = new Date(Date.now() + 864e5), hh = d.getHours();
    if(hh >= 21) d.setDate(d.getDate() + 1);
    if(hh >= 21 || hh < 6) d.setHours(9, 0, 0, 0);
    var auj = new Date(); auj.setHours(0,0,0,0);
    var j = new Date(d); j.setHours(0,0,0,0);
    var mot = Math.round((j - auj) / 864e5) > 1 ? 'après-demain' : 'demain';
    var h = d.getHours() + ' h ' + String(d.getMinutes()).padStart(2,'0');
    document.querySelectorAll('[data-limite-h]').forEach(function(e){ e.textContent = h; });
    document.querySelectorAll('[data-limite-j]').forEach(function(e){ e.textContent = mot + ', ' + JOURS[d.getDay()]; });
    document.querySelectorAll('[data-limite-texte]').forEach(function(e){ e.textContent = mot + ' ' + h; });
  }
  majLimite(); setInterval(majLimite, 30000);

  /* le mail qui s'écrit au défilement, l'échantillon qui tombe */
  var piste = $('piste-mail'), corps = $('mail-corps'), pj = $('mail-pj'), tab = $('tablier'), raisons = document.querySelectorAll('#raisons > div');
  var texte = corps ? corps.dataset.texte : '', grand = matchMedia('(min-width: 961px)');
  function majMail(){
    if(!piste || reduit || !grand.matches){ if(corps) corps.textContent = texte; pj && pj.classList.add('on'); tab && tab.classList.add('on'); raisons.forEach(function(r){ r.classList.add('on'); }); return; }
    var r = piste.getBoundingClientRect(), total = r.height - innerHeight, k = Math.min(1, Math.max(0, -r.top / total));
    var n = Math.round(Math.min(1, k / .72) * texte.length);
    corps.textContent = texte.slice(0, n);
    if(n < texte.length){ var c = document.createElement('span'); c.className = 'caret'; corps.appendChild(c); }
    pj.classList.toggle('on', k > .74); tab.classList.toggle('on', k > .8);
    raisons.forEach(function(e, i){ e.classList.toggle('on', k >= i * .3); });
  }

  /* la bande des signaux : le défilement vertical la fait glisser de côté */
  var ps = $('piste-signaux'), rail = $('rail'), prog = $('prog'), large = matchMedia('(min-width: 861px)');
  function dimSignaux(){
    if(!ps) return;
    if(reduit || !large.matches){ ps.style.height = ''; rail.style.transform = ''; return; }
    var dist = Math.max(0, rail.scrollWidth - innerWidth);
    ps.style.height = (innerHeight + dist) + 'px';
    ps.dataset.dist = dist;
  }
  function majSignaux(){
    if(!ps || reduit || !large.matches) return;
    var r = ps.getBoundingClientRect(), dist = +ps.dataset.dist || 0, k = Math.min(1, Math.max(0, -r.top / Math.max(1, dist)));
    rail.style.transform = 'translateX(' + (-k * dist) + 'px)';
    prog.style.width = (k * 100) + '%';
  }

  var attente = false;
  function cadre(){ if(attente) return; attente = true; requestAnimationFrame(function(){ attente = false; majMail(); majSignaux(); }); }
  addEventListener('scroll', cadre, {passive:true});
  addEventListener('resize', function(){ dimSignaux(); cadre(); });
  dimSignaux(); majMail(); majSignaux();
  if(document.fonts && document.fonts.ready) document.fonts.ready.then(function(){ dimSignaux(); majSignaux(); });
})();
</script>

