{%- comment -%}
  Menu téléphone commun (pages de prestations, outils métier, blog). À placer à la fin de .rt dans l'en-tête.
  Sous 860 px : bouton menu à droite, panneau déroulant avec les rubriques, l'appel et le contact.
  Couleurs en dur : les gabarits n'ont pas tous les mêmes variables.
{%- endcomment -%}
<button class="nvb" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nvm"><i></i><i></i><i></i></button>
<nav class="nvm" id="nvm" aria-label="Menu">
  <a href="/">Accueil</a>
  <a href="/pages/outils-metier">Outils métier<small>Un outil construit autour de votre métier</small></a>
  <a href="/pages/automatisation-ia-entreprise">Automatisation et IA<small>Ce qui se répète, on l'automatise</small></a>
  <a href="/pages/outils-metier#briques">Exemples à essayer<small>Trois outils avec des données fictives</small></a>
  <a href="/pages/outils-metier#prix">Outils sur mesure<small>À partir de 590 €, puis 89 € par mois</small></a>
  <a href="/pages/site-internet">Sites internet<small>Dès 400 €, en ligne en 10 jours ouvrés</small></a>
  <a href="/blogs/blog">Blog</a>
  <div class="nvm-ct">
    <a href="tel:+33786523681" class="nvm-tel">07 86 52 36 81</a>
    <a href="/#appel" class="nvm-go">Parlons-en</a>
  </div>
</nav>
<style>
  .nvb{display:none;width:44px;height:44px;flex:0 0 44px;border-radius:14px;border:1px solid rgba(72,39,25,.14);background:#fff;cursor:pointer;align-items:center;justify-content:center;flex-direction:column;gap:5px;padding:0;margin-left:8px;}
  .nvb i{display:block;width:18px;height:2px;border-radius:2px;background:#482719;transition:transform .25s,opacity .25s;}
  .nvb[aria-expanded="true"] i:nth-child(1){transform:translateY(7px) rotate(45deg);}
  .nvb[aria-expanded="true"] i:nth-child(2){opacity:0;}
  .nvb[aria-expanded="true"] i:nth-child(3){transform:translateY(-7px) rotate(-45deg);}
  .nvm{display:none;}
  @media (max-width:860px){
    .nvb{display:inline-flex;}
    .nvm.open{display:block;position:fixed;top:68px;left:12px;right:12px;z-index:80;background:#fff;border:1px solid rgba(72,39,25,.08);border-radius:20px;box-shadow:0 30px 60px -30px rgba(72,39,25,.45);padding:8px;max-height:calc(100vh - 84px);max-height:calc(100dvh - 84px);overflow:auto;animation:nvm-in .2s ease both;}
    .nvm a{display:block !important;padding:13px 16px !important;border-radius:12px;text-decoration:none;color:#482719 !important;font-weight:600;font-size:16px !important;line-height:1.3;}
    .nvm a:active,.nvm a:hover{background:#F3F6FA;}
    .nvm a small{display:block;font-weight:400;font-size:13px;color:rgba(72,39,25,.6);margin-top:2px;}
    .nvm-ct{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:8px;border-top:1px solid rgba(72,39,25,.08);margin-top:6px;}
    .nvm-ct a{text-align:center;border-radius:100px;padding:14px 10px !important;font-size:15px !important;}
    .nvm-ct .nvm-tel{border:1px solid rgba(72,39,25,.14);}
    .nvm-ct .nvm-go{background:#FF681F;}
    @keyframes nvm-in{from{opacity:0;transform:translateY(-6px);}}
  }
</style>
<script>
  (function(){
    var b = document.currentScript.parentNode.querySelector('.nvb'), m = document.getElementById('nvm');
    if (!b || !m) return;
    function poser(o){ m.classList.toggle('open', o); b.setAttribute('aria-expanded', o ? 'true' : 'false'); b.setAttribute('aria-label', o ? 'Fermer le menu' : 'Ouvrir le menu'); }
    b.addEventListener('click', function(e){ e.stopPropagation(); poser(!m.classList.contains('open')); });
    m.addEventListener('click', function(e){ if (e.target.closest('a')) poser(false); });
    document.addEventListener('click', function(e){ if (m.classList.contains('open') && !m.contains(e.target)) poser(false); });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape') poser(false); });
  })();
</script>
