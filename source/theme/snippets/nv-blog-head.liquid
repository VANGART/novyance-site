<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="only light">
<meta name="theme-color" content="#F3F6FA">
{%- if current_page > 1 -%}
<meta name="robots" content="noindex, follow">
{%- else -%}
<meta name="robots" content="index, follow, max-image-preview:large">
{%- endif %}
<meta property="og:locale" content="fr_FR">
<link rel="icon" type="image/png" sizes="48x48" href="{{ 'nv-favicon-48.png' | asset_url }}">
<link rel="apple-touch-icon" href="{{ 'nv-apple-touch.png' | asset_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
<style>
:root{--bg:#F3F6FA;--bg2:#E9EEF5;--white:#FFF;--ink:#482719;--muted:rgba(72,39,25,.7);--soft:rgba(72,39,25,.6);--hair:rgba(72,39,25,.12);--hair-2:rgba(72,39,25,.07);--orange:#FF681F;--rose:#FF9EBC;--rose-s:#FFE6EE;--jaune-s:#FFF2D0;--bleu-s:#DFE7FF;--t:'Space Grotesk','DM Sans',system-ui,sans-serif;--b:'DM Sans',system-ui,-apple-system,'Segoe UI',Arial,sans-serif;--e:cubic-bezier(.22,.61,.36,1);}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;color-scheme:only light;}
body{background:var(--bg);color:var(--ink);font-family:var(--b);font-size:16px;line-height:1.7;-webkit-font-smoothing:antialiased;overflow-x:hidden;}
a{color:inherit;}
b,strong{font-weight:600;}
h1,h2,h3{font-family:var(--t);font-weight:700;letter-spacing:-.02em;line-height:1.12;}
.wrap{max-width:760px;margin:0 auto;padding:0 28px;}
.wide{max-width:1180px;}
.dot{color:var(--orange);}
.btn{display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:14px;padding:13px 22px;border-radius:100px;background:var(--orange);color:var(--ink);border:0;cursor:pointer;text-decoration:none;transition:background .3s,box-shadow .35s;}
.btn:hover{background:#FF7A3A;box-shadow:0 12px 28px -14px rgba(255,104,31,.7);}
header{position:sticky;top:0;z-index:50;background:rgba(243,246,250,.86);backdrop-filter:blur(14px);border-bottom:1px solid var(--hair-2);}
header .wrap{max-width:1180px;display:flex;justify-content:space-between;align-items:center;height:62px;}
.brand{font-family:var(--t);font-weight:700;font-size:20px;letter-spacing:-.03em;text-decoration:none;}
header .rt{display:flex;gap:18px;align-items:center;font-size:13.5px;font-weight:500;}
header .rt a{color:var(--muted);text-decoration:none;}
header .rt a:hover{color:var(--ink);}
header .rt a.btn{color:var(--ink);padding:9px 16px;font-size:13px;}
.bc{font-size:12.5px;color:var(--soft);padding:22px 0 0;}
.bc a{color:var(--soft);text-decoration:none;}
.bc a:hover{color:var(--orange);}
.hd{padding:16px 0 26px;}
.hd h1{font-size:clamp(28px,4.2vw,44px);margin-bottom:14px;}
.lead{font-size:18px;color:var(--muted);}
.meta{display:flex;gap:14px;flex-wrap:wrap;font-size:13px;color:var(--soft);margin-top:14px;}
.meta span+span::before{content:'·';margin-right:14px;}
.cover{margin:6px 0 10px;border-radius:20px;overflow:hidden;background:var(--bg2);}
.cover img{display:block;width:100%;height:auto;}
.rte{padding:22px 0 10px;font-size:17px;}
.rte h2{font-size:clamp(22px,2.5vw,27px);margin:38px 0 12px;}
.rte h3{font-size:18px;margin:26px 0 8px;}
.rte p{margin-bottom:16px;color:rgba(72,39,25,.82);}
.rte p strong,.rte li strong{color:var(--ink);}
.rte ul,.rte ol{margin:0 0 18px;padding-left:0;list-style:none;}
.rte li{position:relative;padding-left:18px;margin-bottom:9px;color:rgba(72,39,25,.82);}
.rte li::before{content:'';position:absolute;left:0;top:11px;width:6px;height:6px;border-radius:50%;background:var(--orange);}
.rte a{color:var(--ink);font-weight:600;text-decoration:none;border-bottom:1.5px solid var(--orange);}
.rte img{max-width:100%;height:auto;border-radius:16px;margin:10px 0;}
.rte table{width:100%;border-collapse:collapse;margin:8px 0 22px;font-size:15px;display:block;overflow-x:auto;}
.rte th,.rte td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--hair);}
.rte th{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:600;}
.rte tr:first-child td{font-weight:600;color:var(--ink);}
.rte blockquote{background:var(--rose-s);border-radius:16px;padding:20px 22px;margin:22px 0;font-size:16px;}
.rte blockquote p:last-child{margin-bottom:0;}
.aut{display:flex;gap:14px;align-items:center;background:var(--white);border:1px solid var(--hair-2);border-radius:18px;padding:18px 20px;margin:30px 0 10px;}
.aut .mono{width:46px;height:46px;border-radius:14px;background:var(--rose);display:grid;place-items:center;font-family:var(--t);font-weight:700;font-size:22px;flex:none;}
.aut .mono i{color:var(--orange);font-style:normal;}
.aut p{font-size:14px;color:var(--muted);}
.aut b{color:var(--ink);}
.posts{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
.post{background:var(--white);border:1px solid var(--hair-2);border-radius:18px;padding:22px;text-decoration:none;display:flex;flex-direction:column;gap:10px;transition:transform .35s var(--e),box-shadow .35s var(--e);}
.post:hover{transform:translateY(-3px);box-shadow:0 22px 40px -28px rgba(72,39,25,.35);}
.post small{font-size:12px;color:var(--soft);letter-spacing:.04em;}
.post b{font-family:var(--t);font-size:18px;line-height:1.25;}
.post span{font-size:14px;color:var(--muted);flex:1;}
.post em{font-style:normal;font-size:13px;font-weight:600;color:#C94A0E;}
.pag{display:flex;justify-content:center;gap:10px;margin:30px 0;font-size:14px;}
.pag a,.pag span{padding:8px 14px;border-radius:100px;background:var(--white);text-decoration:none;}
.more{padding:40px 0 10px;}
.more h2{font-size:clamp(20px,2.4vw,26px);margin-bottom:16px;}
.ct{background:var(--bg2);margin-top:44px;padding:48px 0 52px;}
.ct h2{font-size:clamp(22px,2.6vw,30px);margin-bottom:10px;}
.ct p{color:var(--muted);margin-bottom:20px;}
footer{background:var(--bg2);padding:30px 0;border-top:1px solid var(--hair);}
footer .wrap{max-width:1180px;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;font-size:13px;color:var(--muted);}
footer a{color:var(--muted);text-decoration:none;}
footer a:hover{color:var(--orange);}
footer .lk{display:flex;gap:18px;flex-wrap:wrap;}
@media (max-width:860px){.posts{grid-template-columns:1fr 1fr;}}
@media (max-width:620px){.wrap{padding:0 20px;}.posts{grid-template-columns:1fr;}header .rt a:not(.btn){display:none;}.rte{font-size:16px;}footer .lk a{padding:6px 0;}}
</style>
