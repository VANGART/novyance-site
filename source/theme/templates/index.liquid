  <h4>Finalités</h4><p>Répondre aux demandes et exécuter les prestations commandées.</p>
  <h4>Conservation</h4><p>Trois ans après le dernier contact. Dix ans pour les pièces comptables.</p>
  <h4>Vos droits</h4><p>Accès, rectification, effacement et opposition à contact@novyance.fr. Réclamation possible auprès de la CNIL.</p>
  <h4>Cookies</h4><p>Aucun cookie de suivi publicitaire.</p>
</dialog>

<script>
(() => {
  const $ = s => document.querySelector(s), $$ = s => [...document.querySelectorAll(s)];
  /* apparitions */
  if('IntersectionObserver' in window){
    const io = new IntersectionObserver(es => es.forEach(e => { if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } }), {threshold:0, rootMargin:'0px 0px 120px 0px'});
    $$('.rv').forEach(el => io.observe(el));
  } else $$('.rv').forEach(el => el.classList.add('in'));
  /* menu mobile */
  const bg = $('#burger'), mn = $('#mnav');
  if(bg && mn){
    bg.addEventListener('click', () => { const o = mn.classList.toggle('open'); bg.setAttribute('aria-expanded', o); });
    mn.addEventListener('click', e => { if(e.target.closest('a')){ mn.classList.remove('open'); bg.setAttribute('aria-expanded', 'false'); } });
  }
  /* boutons qui préremplissent le besoin du formulaire */
  document.addEventListener('click', e => { const a = e.target.closest('[data-besoin]'); const sel = $('#bes'); if(a && sel) sel.value = a.dataset.besoin; });
  /* en-tête */
  const hd = $('#hd'); addEventListener('scroll', () => hd.classList.toggle('sc', scrollY > 10), {passive:true});
  /* démos : chargées seulement quand on arrive dessus */
  const fr = $('#dframe'), url = $('#durl'), full = $('#dfull');
  /* Shopify interdit d'afficher ses pages dans un cadre : on charge la démo puis on l'injecte */
  const show = src => fetch(src, {credentials:'same-origin'}).then(r => r.text())
    .then(h => { fr.srcdoc = h.replace('</head>', '<style>.nv-back{display:none!important}</style></head>'); })
    .catch(() => { fr.removeAttribute('srcdoc'); fr.src = src; });
  let loaded = false;
  const load = () => { if(!loaded){ loaded = true; show(fr.dataset.src); } };
  /* sur téléphone, les démos s'ouvrent en plein écran depuis des cartes : le cadre n'est pas chargé */
  if(matchMedia('(max-width:760px)').matches){ /* rien */ }
  else if('IntersectionObserver' in window){
    new IntersectionObserver((es, o) => es.forEach(e => { if(e.isIntersecting){ load(); o.disconnect(); } }), {rootMargin:'300px'}).observe(fr);
  } else load();
  $$('.demo-tabs button').forEach(b => b.addEventListener('click', () => {
    $$('.demo-tabs button').forEach(x => { x.classList.toggle('on', x === b); x.setAttribute('aria-selected', x === b); });
    loaded = true; show(b.dataset.src); full.href = b.dataset.src; url.textContent = 'votre-entreprise.novyance.fr/' + b.dataset.url;
  }));
  /* mentions */
  $$('[data-dlg]').forEach(b => b.addEventListener('click', () => { const d = document.getElementById(b.dataset.dlg); if(d.showModal) d.showModal(); }));
  $$('dialog [data-close]').forEach(b => b.addEventListener('click', () => b.closest('dialog').close()));
  $$('dialog').forEach(d => d.addEventListener('click', e => { if(e.target === d) d.close(); }));
  /* anti-robot du formulaire */
  const cf = $('#cf'); if(cf) cf.addEventListener('submit', e => { const hp = $('#hp'); if(hp && hp.value) e.preventDefault(); });
})();
</script>
<script src="{{ 'nv-bot.js' | asset_url }}" defer></script>

<script>
  // carrousels sur téléphone : des points sous chaque rangée de cartes, celui de la carte visible en orange
  (function(){
    var mq = matchMedia('(max-width:760px)');
    document.querySelectorAll('.acc, .sites, .refs, .demo-m').forEach(function(c){
      var n = c.children.length; if (n < 2) return;
      var d = document.createElement('div'); d.className = 'car-dots'; d.setAttribute('aria-hidden', 'true');
      for (var i = 0; i < n; i++) d.appendChild(document.createElement('i'));
      c.after(d);
      function maj(){
        d.style.display = mq.matches ? '' : 'none';
        var w = c.children[0].getBoundingClientRect().width + 12, k = Math.round(c.scrollLeft / w);
        if (c.scrollLeft + c.clientWidth >= c.scrollWidth - 4) k = n - 1;
        [].forEach.call(d.children, function(x, j){ x.classList.toggle('on', j === k); });
      }
      c.addEventListener('scroll', function(){ requestAnimationFrame(maj); }, {passive: true});
      mq.addEventListener ? mq.addEventListener('change', maj) : mq.addListener(maj);
      maj();
    });
  })();
</script>
<div class="mbar" id="mbar" aria-hidden="true" inert><a href="tel:+33786523681" class="mb-tel">Appeler</a><a href="#contact" class="mb-go">Décrire mon besoin</a></div>
<script>
  // barre d'action sur téléphone : visible après le haut de page, cachée sur le formulaire de contact
  (function(){
    var b = document.getElementById('mbar'), hero = document.querySelector('.hero'), ct = document.getElementById('contact');
    if (!b || !hero || !('IntersectionObserver' in window)) return;
    var apresHero = false, surContact = false;
    function maj(){ var on = apresHero && !surContact; b.classList.toggle('on', on); b.setAttribute('aria-hidden', on ? 'false' : 'true'); b.inert = !on; }
    new IntersectionObserver(function(e){ apresHero = !e[0].isIntersecting; maj(); }).observe(hero);
    if (ct) new IntersectionObserver(function(e){ surContact = e[0].isIntersecting; maj(); }, {threshold: .15}).observe(ct);
  })();
</script>
