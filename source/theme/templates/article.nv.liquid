{% layout none %}
{%- assign desc = article.metafields.global.description_tag | default: article.excerpt_or_content | strip_html | strip_newlines | truncate: 158 -%}
{%- assign ttl = article.metafields.global.title_tag | default: article.title -%}
<!DOCTYPE html>
<html lang="fr">
<head>
{% render 'nv-blog-head' %}
<title>{{ ttl }} · Novyance</title>
<meta name="description" content="{{ desc | escape }}">
<meta property="og:title" content="{{ ttl | escape }}">
<meta property="og:description" content="{{ desc | escape }}">
<meta property="og:type" content="article">
<meta property="og:url" content="{{ shop.url }}{{ article.url }}">
{% if article.image %}<meta property="og:image" content="https:{{ article.image | image_url: width: 1200 }}">
<meta name="twitter:card" content="summary_large_image">{% else %}<meta property="og:image" content="https:{{ 'nv-og.png' | asset_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">{% endif %}
<link rel="canonical" href="{{ shop.url }}{{ article.url }}">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BlogPosting","headline":{{ article.title | json }},"description":{{ desc | json }},"datePublished":{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},"dateModified":{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},"image":{% if article.image %}{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}{% else %}{{ 'nv-og.png' | asset_url | prepend: 'https:' | json }}{% endif %},"mainEntityOfPage":{{ shop.url | append: article.url | json }},"author":{"@type":"Person","name":"Aurélien Ruotte","url":"https://novyance.fr/"},"publisher":{"@type":"Organization","name":"Novyance","url":"https://novyance.fr/","logo":{"@type":"ImageObject","url":{{ 'nv-apple-touch.png' | asset_url | prepend: 'https:' | json }}}}}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://novyance.fr/"},{"@type":"ListItem","position":2,"name":"Blog","item":{{ shop.url | append: blog.url | json }}},{"@type":"ListItem","position":3,"name":{{ article.title | json }},"item":{{ shop.url | append: article.url | json }}}]}
</script>
{{ content_for_header }}
</head>
<body>
{% render 'nv-blog-chrome', part: 'header' %}
<article class="wrap">
  <div class="bc"><a href="/">Accueil</a> · <a href="{{ blog.url }}">Blog</a> · {{ article.title }}</div>
  <div class="hd">
    <h1>{{ article.title }}</h1>
    {% if article.excerpt != blank %}<p class="lead">{{ article.excerpt | strip_html }}</p>{% endif %}
    <div class="meta"><span>Aurélien Ruotte</span><span>{{ article.published_at | date: '%d/%m/%Y' }}</span><span>{{ article.content | strip_html | split: ' ' | size | divided_by: 220 | at_least: 1 }} min de lecture</span></div>
  </div>
  {% if article.image %}<div class="cover"><img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.image.alt | default: article.title | escape }}" width="{{ article.image.width }}" height="{{ article.image.height }}"></div>{% endif %}
  <div class="rte">{{ article.content }}</div>
  <div class="aut"><div class="mono">n<i>.</i></div><p><b>Aurélien Ruotte</b>, fondateur de Novyance à Lyon. Il construit des sites et des outils sur mesure pour les TPE et PME, et répond lui-même à chaque demande.</p></div>
</article>
{%- assign rel = 0 -%}
{%- capture relhtml -%}{% for a in blog.articles limit: 4 %}{% unless a.id == article.id or rel >= 3 %}{% assign rel = rel | plus: 1 %}<a class="post" href="{{ a.url }}"><small>{{ a.published_at | date: '%d/%m/%Y' }}</small><b>{{ a.title }}</b><span>{{ a.excerpt_or_content | strip_html | truncatewords: 20 }}</span><em>Lire →</em></a>{% endunless %}{% endfor %}{%- endcapture -%}
{% if rel > 0 %}<section class="wrap wide more"><h2>À lire aussi<span class="dot">.</span></h2><div class="posts">{{ relhtml }}</div></section>{% endif %}
{% render 'nv-blog-chrome', part: 'footer' %}
</body>
</html>
