{% layout none %}
{%- assign ttl = page.metafields.global.title_tag | default: page.title -%}
{%- assign dsc = page.metafields.global.description_tag | default: page.title -%}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="only light">
<meta name="theme-color" content="#F3F6FA">
<title>{{ ttl }}</title>
<meta name="description" content="{{ dsc | escape }}">
{% if page.metafields.seo.hidden == 1 or page.metafields.seo.hidden == "1" %}<meta name="robots" content="noindex, nofollow">{% else %}<meta name="robots" content="index, follow, max-image-preview:large">{% endif %}
<meta property="og:title" content="{{ ttl | escape }}">
<meta property="og:description" content="{{ dsc | escape }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="fr_FR">
<meta property="og:image" content="https:{{ 'nv-og.png' | asset_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta property="og:url" content="{{ shop.url }}{{ page.url }}">
<link rel="canonical" href="{{ shop.url }}{{ page.url }}">
<link rel="icon" type="image/png" sizes="48x48" href="{{ 'nv-favicon-48.png' | asset_url }}">
<link rel="apple-touch-icon" href="{{ 'nv-apple-touch.png' | asset_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
{%- unless page.handle == 'mentions-legales' or page.metafields.seo.hidden == 1 or page.metafields.seo.hidden == "1" -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": {{ page.title | json }},
  "description": {{ dsc | json }},
  "url": {{ shop.url | append: page.url | json }},
  "areaServed": [{"@type": "City", "name": "Lyon"}, {"@type": "Country", "name": "France"}],
  "provider": {
    "@type": "ProfessionalService",
    "name": "Novyance",
    "url": "https://novyance.fr/",
    "email": "contact@novyance.fr",
    "telephone": "+33786523681",
    "address": {"@type": "PostalAddress", "streetAddress": "304 avenue Jean Jaurès", "addressLocality": "Lyon", "postalCode": "69007", "addressCountry": "FR"}
  }
}
</script>
{%- endunless -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://novyance.fr/"},
    {"@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ shop.url | append: page.url | json }}}
  ]
}
</script>
<style>
  :root{
    --bg:#F3F6FA; --bg2:#E9EEF5; --white:#FFFFFF;
    --ink:#482719; --muted:rgba(72,39,25,.64); --soft:rgba(72,39,25,.6); --hair:rgba(72,39,25,.12); --hair-2:rgba(72,39,25,.07);
    --orange:#FF681F; --rose:#FF9EBC; --rose-s:#FFE6EE; --jaune:#FFC531; --jaune-s:#FFF2D0; --bleu:#3D6FF0; --bleu-s:#DFE7FF;
    --t:'Space Grotesk','DM Sans',system-ui,sans-serif; --b:'DM Sans',system-ui,-apple-system,'Segoe UI',Arial,sans-serif;
    --e:cubic-bezier(.22,.61,.36,1);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;color-scheme:only light;}
  @media (prefers-color-scheme: dark){ html,body{background:#F3F6FA !important;color:#482719 !important;} }
  body{background:var(--bg);color:var(--ink);font-family:var(--b);font-size:16px;line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden;}
  a{color:inherit;}
  b,strong{font-weight:600;}
  h1,h2,h3{font-family:var(--t);font-weight:700;letter-spacing:-.02em;line-height:1.1;}
  .wrap{max-width:820px;margin:0 auto;padding:0 28px;}
  .wide{max-width:1180px;}
  .dot{color:var(--orange);}
  .btn{display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:14px;padding:13px 22px;border-radius:100px;background:var(--orange);color:var(--ink);border:0;cursor:pointer;text-decoration:none;transition:background .3s,box-shadow .35s;}
  .btn:hover{background:#FF7A3A;box-shadow:0 12px 28px -14px rgba(255,104,31,.7);}
  header{position:sticky;top:0;z-index:50;background:rgba(243,246,250,.86);backdrop-filter:blur(14px);border-bottom:1px solid var(--hair-2);}
  header .wrap{max-width:1180px;display:flex;justify-content:space-between;align-items:center;height:62px;}
  .brand{font-family:var(--t);font-weight:700;font-size:20px;letter-spacing:-.03em;text-decoration:none;}
  header .rt{display:flex;gap:18px;align-items:center;font-size:13.5px;font-weight:500;}
  header .rt a{color:var(--muted);text-decoration:none;}
  header .rt a.btn{color:var(--ink);padding:9px 16px;font-size:13px;}
  .bc{font-size:12.5px;color:var(--soft);padding:22px 0 0;}
  .bc a{color:var(--soft);text-decoration:none;}
  .bc a:hover{color:var(--orange);}
  .hd{padding:16px 0 30px;}
  h1{font-size:clamp(28px,4vw,42px);margin-bottom:14px;}
  .lead{font-size:18px;color:var(--muted);}
  .cta-top{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin-top:22px;padding-bottom:26px;border-bottom:1px solid var(--hair);}
  .cta-top .ph{font-family:var(--t);font-weight:700;font-size:17px;text-decoration:none;border-bottom:2px solid var(--orange);}
  .rte{padding:26px 0 10px;}
  .rte h2{font-size:clamp(21px,2.4vw,26px);margin:34px 0 12px;}
  .rte h3{font-size:17px;margin:24px 0 8px;}
  .rte p{margin-bottom:14px;color:var(--muted);}
  .rte p strong,.rte li strong{color:var(--ink);}
  .rte ul,.rte ol{margin:0 0 16px 0;padding-left:0;list-style:none;}
  .rte li{position:relative;padding-left:16px;margin-bottom:8px;color:var(--muted);}
  .rte li::before{content:'';position:absolute;left:0;top:10px;width:5px;height:5px;border-radius:50%;background:var(--orange);}
  .rte a{color:var(--ink);font-weight:600;text-decoration:none;border-bottom:1.5px solid var(--orange);}
  .rte table{width:100%;border-collapse:collapse;margin:8px 0 20px;font-size:14.5px;}
  .rte th,.rte td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--hair);}
  .rte th{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:600;}
  .rte td:last-child{text-align:right;white-space:nowrap;font-weight:600;}
  .rte blockquote{background:var(--bleu-s);border-radius:16px;padding:20px 22px;margin:20px 0;font-size:15px;}
  .rte blockquote p:last-child{margin-bottom:0;}
  .cards{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:18px 0 24px;}
  .cards div{background:var(--white);border:1px solid var(--hair-2);border-radius:14px;padding:16px 18px;border-top:3px solid var(--bleu);}
  .cards div:nth-child(2){border-top-color:var(--jaune);}
  .cards div:nth-child(3){border-top-color:var(--rose);}
  .cards div:nth-child(4){border-top-color:var(--orange);}
  .cards b{display:block;font-family:var(--t);font-size:15px;margin-bottom:5px;}
  .cards span{font-size:13.5px;color:var(--muted);}
  .box{background:var(--white);border:1px solid var(--hair-2);border-radius:18px;padding:22px 24px;margin:22px 0;}
  .box b{font-family:var(--t);font-size:16px;display:block;margin-bottom:6px;}
  .ct{background:var(--bg2);margin-top:40px;padding:48px 0 52px;}
  .ct h2{font-size:clamp(22px,2.6vw,30px);margin-bottom:10px;}
  .ct > .wrap > p{color:var(--muted);margin-bottom:22px;}
  form{display:grid;grid-template-columns:1fr 1fr;gap:18px 16px;background:var(--white);border:1px solid var(--hair-2);padding:24px;border-radius:18px;}
  .fl{display:flex;flex-direction:column;}
  .fl.full{grid-column:span 2;}
  .fl label{font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;font-weight:600;color:var(--muted);margin-bottom:7px;}
  .fl input,.fl textarea{background:transparent;border:none;border-bottom:1.5px solid var(--hair);padding:8px 0;color:var(--ink);font-family:inherit;font-size:15.5px;font-weight:500;width:100%;border-radius:0;}
  .fl textarea{min-height:70px;resize:vertical;}
  .fl input:focus,.fl textarea:focus{outline:none;border-color:var(--orange);}
  .fl input::placeholder,.fl textarea::placeholder{color:var(--soft);font-weight:400;}
  .f-sub{grid-column:span 2;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;}
  .f-note{font-size:12px;color:var(--soft);max-width:300px;}
  .f-ok{grid-column:span 2;font-size:14px;background:var(--jaune-s);padding:13px 16px;border-radius:10px;}
  footer{background:var(--bg2);padding:34px 0 30px;border-top:1px solid var(--hair);}
  footer .wrap{max-width:1180px;display:flex;justify-content:space-between;gap:22px;flex-wrap:wrap;font-size:13px;color:var(--muted);}
  footer a{color:var(--muted);text-decoration:none;}
  footer a:hover{color:var(--orange);}
  footer .lk{display:flex;gap:18px;flex-wrap:wrap;}
  @media (max-width:700px){
    .wrap{padding:0 20px;}
    .cards{grid-template-columns:1fr;}
    form{grid-template-columns:1fr;padding:20px;}
    .fl.full,.f-sub,.f-ok{grid-column:span 1;}
    header .rt a:not(.btn){display:none;}
    .rte table{font-size:14px;}
    .rte th,.rte td{padding:10px 6px;}
    .rte td:last-child{white-space:normal;min-width:96px;}
    .ct{padding:36px 0 40px;}
    footer .lk a{padding:6px 0;}
  }
  .voir{display:flex;flex-wrap:wrap;gap:8px;margin:26px 0 8px;padding:18px;background:var(--white);border:1px solid var(--hair-2);border-radius:16px;align-items:center;}
  .voir b{width:100%;font-family:var(--t);font-size:15px;}
  .voir a{font-size:14px;font-weight:600;text-decoration:none;padding:9px 14px;border-radius:100px;background:var(--bg);border:1px solid var(--hair);}
  .voir a:hover{border-color:var(--orange);}
</style>
{{ content_for_header }}
</head>
<body>

<header>
  <div class="wrap">
    <a href="/" class="brand">novyance<span class="dot">.</span></a>
    <div class="rt">
      <a href="/">Accueil</a>
      <a href="/pages/outils-metier">Outils</a>
      <a href="tel:+33786523681">07 86 52 36 81</a>
      <a href="#contact" class="btn">Parlons-en</a>
      {% render 'nv-mnav' %}
    </div>
  </div>
</header>

<main class="wrap">
  <div class="bc"><a href="/">Accueil</a> · {{ page.title }}</div>
  <div class="hd">
    <h1>{{ page.title }}</h1>
    {% if page.metafields.global.description_tag %}<p class="lead">{{ page.metafields.global.description_tag }}</p>{% endif %}
    <div class="cta-top">
      <a href="#contact" class="btn">Demander un devis</a>
      <a href="tel:+33786523681" class="ph">07 86 52 36 81</a>
    </div>
  </div>
  <div class="rte">{{ page.content }}</div>
  {%- comment -%} Maillage : chaque page renvoie vers ses voisines (audit SEO du 06/10/2026) {%- endcomment -%}
  {%- case page.handle -%}
    {%- when 'creation-site-internet-lyon', 'site-internet-artisan', 'boutique-en-ligne-commercant' -%}
      {%- assign voir = "/blogs/blog/prix-site-internet-artisan|Combien coûte un site internet pour un artisan ?;/pages/site-internet-artisan|Site internet pour artisan;/pages/creation-site-internet-lyon|Création de site internet à Lyon;/pages/outils-metier|Et après le site : un outil sur mesure" -%}
    {%- when 'automatisation-ia-entreprise' -%}
      {%- assign voir = "/pages/prospection-automatisee|Prospection et relances automatiques;/pages/application-pilotage-sur-mesure|Pilotage en direct;/pages/crm-sur-mesure|CRM sur mesure;/pages/outils-metier|Tous les outils métier" -%}
    {%- when 'application-pilotage-sur-mesure' -%}
      {%- assign voir = "/pages/demo-pilotage|Essayer la démo pilotage;/pages/outils-metier|Tous les outils métier;/pages/automatisation-ia-entreprise|Automatisation et IA;/blogs/blog/logiciel-planning-atelier-menuiserie|Planning d'atelier : bien choisir" -%}
    {%- when 'crm-sur-mesure' -%}
      {%- assign voir = "/pages/prospection-automatisee|Prospection et relances automatiques;/pages/demo-commercial|Essayer la démo commerciale;/pages/outils-metier|Tous les outils métier;/pages/automatisation-ia-entreprise|Automatisation et IA" -%}
    {%- when 'prospection-automatisee' -%}
      {%- assign voir = "/pages/crm-sur-mesure|CRM sur mesure;/pages/demo-commercial|Essayer la démo commerciale;/pages/automatisation-ia-entreprise|Automatisation et IA;/pages/apporteurs-affaires|Devenir apporteur d'affaires" -%}
    {%- when 'apporteurs-affaires' -%}
      {%- assign voir = "/pages/outils-metier|Les outils que vous recommandez;/pages/creation-site-internet-lyon|Les sites que vous recommandez;/pages/prospection-automatisee|Prospection et relances automatiques" -%}
    {%- else -%}
      {%- assign voir = "" -%}
  {%- endcase -%}
  {%- if voir != "" -%}
  <nav class="voir" aria-label="À lire aussi"><b>À lire aussi</b>
    {%- assign lignes = voir | split: ';' -%}{%- for l in lignes -%}{%- assign x = l | split: '|' -%}<a href="{{ x[0] }}">{{ x[1] }}</a>{%- endfor -%}
  </nav>
  {%- endif -%}
</main>

<section class="ct" id="contact">
  <div class="wrap">
    <h2>Parlons de votre projet<span class="dot">.</span></h2>
    <p>Décrivez votre situation en deux lignes. Réponse et devis ferme sous 24 h ouvrées.</p>
    {% form 'contact', id: 'cf' %}
      <div class="fl"><label for="nom">Nom</label><input type="text" id="nom" name="contact[Nom]" placeholder="Votre nom" required></div>
      <div class="fl"><label for="mail">Email</label><input type="email" id="mail" name="contact[email]" placeholder="vous@exemple.fr" required></div>
      <div class="fl"><label for="tel">Téléphone</label><input type="tel" id="tel" name="contact[Telephone]" placeholder="06 00 00 00 00"></div>
      <div class="fl"><label for="soc">Entreprise</label><input type="text" id="soc" name="contact[Societe]" placeholder="Votre activité"></div>
      <div class="fl full"><label for="msg">Votre situation</label><textarea id="msg" name="contact[body]" placeholder="Ce que vous voulez obtenir, ou ce qui vous fait perdre du temps aujourd'hui"></textarea></div>
      <input type="hidden" name="contact[Page]" value="{{ page.title | escape }}">
      <div class="f-sub"><span class="f-note">Vos informations servent uniquement à répondre à votre demande.</span><button type="submit" class="btn">Envoyer</button></div>
      {% if form.posted_successfully %}<div class="f-ok">Demande envoyée. Réponse sous 24 heures ouvrées.</div>{% endif %}
      {% if form.errors %}<div class="f-ok" style="background:rgba(192,69,47,.1)">Une erreur s'est produite. Vérifiez votre adresse email, ou écrivez-moi à contact@novyance.fr.</div>{% endif %}
    {% endform %}
  </div>
</section>

<footer>
  <div class="wrap">
    <span>Novyance · Aurélien Ruotte · Lyon · <a href="mailto:contact@novyance.fr">contact@novyance.fr</a></span>
    <span class="lk">
      <a href="/pages/outils-metier">Outils métier</a>
      <a href="/pages/creation-site-internet-lyon">Site à Lyon</a>
      <a href="/pages/site-internet-artisan">Artisans</a>
      <a href="/pages/boutique-en-ligne-commercant">Boutique en ligne</a>
      <a href="/pages/automatisation-ia-entreprise">Automatisation &amp; IA</a>
      <a href="/pages/application-pilotage-sur-mesure">Pilotage</a>
      <a href="/pages/crm-sur-mesure">CRM sur mesure</a>
      <a href="/pages/prospection-automatisee">Prospection automatique</a>
      <a href="/pages/apporteurs-affaires">Apporteurs d'affaires</a>
      <a href="/blogs/blog">Blog</a>
      <a href="/">Accueil</a>
      {%- assign ml = pages['mentions-legales'] -%}{% if ml.published_at != blank and ml.url != blank %}
      <a href="{{ ml.url }}">Mentions légales</a>{% endif %}
    </span>
  </div>
</footer>

</body>
</html>
